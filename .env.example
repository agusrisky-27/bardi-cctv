# RCIS (Restaurant CCTV Intelligence System) Environment Configuration
# Never commit the actual .env file with real credentials or stream URLs.

# Application Environment (development, testing, production)
RCIS_ENV=development
RCIS_LOG_LEVEL=INFO

# CCTV Source Configuration
# Types: file, webcam, rtsp
RCIS_VIDEO_SOURCE_TYPE=file
RCIS_VIDEO_SOURCE_PATH=data/videos/sample_restaurant.mp4

# RTSP Stream Settings (if using RTSP IP camera)
# BARDI (community-reported, verify in VLC first): port 8554, main /Streaming/Channels/101, sub /Streaming/Channels/102
# Example: rtsp://admin:PASSWORD@192.168.1.50:8554/Streaming/Channels/102
# Used by: python -m rcis.cli --rtsp   (no value = read this variable)
RCIS_RTSP_URL=
RCIS_RTSP_USERNAME=
RCIS_RTSP_PASSWORD=
RCIS_RTSP_TIMEOUT_SEC=10
RCIS_RTSP_RECONNECT_INTERVAL_SEC=5

# Model / Inference Settings
RCIS_MODEL_PATH=models/yolo11n.pt
RCIS_MODEL_DEVICE=mps  # Options: mps (Apple Silicon Metal Performance Shaders), cpu, cuda
RCIS_CONFIDENCE_THRESHOLD=0.35
RCIS_IOU_THRESHOLD=0.50
RCIS_INPUT_SIZE=640

# Database Settings
RCIS_DB_PATH=data/rcis.db

# Web dashboard (python -m rcis.cli --web  /  python -m rcis.web)
# Empty = dashboard only reachable from this Mac (127.0.0.1).
# Set a password = reachable from phones on the same Wi-Fi (http://<IP-Mac>:8000, any username).
RCIS_WEB_PASSWORD=

# Database backup folder (copied every hour + when the program stops).
# Use a cloud-synced folder so data survives a device change, e.g. OneDrive or Google Drive for Desktop:
#   ~/Library/CloudStorage/OneDrive-<name>/cctv_resto/backup
#   ~/Library/CloudStorage/GoogleDrive-<email>/My Drive/cctv_resto/backup
# Empty = data/backups (local only). To restore on a new device: copy rcis_latest.db to data/rcis.db
RCIS_BACKUP_DIR=

# Telegram alerts (optional). Create a bot with @BotFather, then run: python scripts/telegram_test.py
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Roboflow (only for scripts/check_datasets.py; Colab reads its own key from Colab Secrets)
ROBOFLOW_API_KEY=

# Camera mounted upside down (tripod / ceiling)? 180 rotates the image for analytics and draw_zones. 0 = normal.
RCIS_CAMERA_ROTATE=0
